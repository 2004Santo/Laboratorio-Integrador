# Copiar este archivo como .env y completar los valores:  cp .env.example .env

# ---------- Postgres (backend de Kestra) ----------
POSTGRES_DB=kestra
POSTGRES_USER=kestra
POSTGRES_PASSWORD=cambiar_esta_clave

# ---------- Kestra UI (basic auth) ----------
# El usuario debe ser un email válido y la contraseña de al menos 8 caracteres
KESTRA_ADMIN_USER=admin@example.com
KESTRA_ADMIN_PASSWORD=cambiar_esta_clave

# ---------- Snowflake: admin (solo para el flow snowflake_setup) ----------
# Usuario con rol ACCOUNTADMIN
SNOWFLAKE_ADMIN_USER=
SNOWFLAKE_ADMIN_PASSWORD=

# ---------- Snowflake: cuenta ----------
# Identificador de cuenta, ej: abcdefg-xy12345 (sin .snowflakecomputing.com)
SNOWFLAKE_ACCOUNT=

# ---------- Snowflake: objetos de la tubería (los crea el flow snowflake_setup) ----------
SNOWFLAKE_USER=ELT_USER
SNOWFLAKE_PASSWORD=cambiar_esta_clave
SNOWFLAKE_ROLE=ELT_ROLE
SNOWFLAKE_WAREHOUSE=ELT_WH
SNOWFLAKE_DATABASE=NYC_TAXI
SNOWFLAKE_SCHEMA=RAW
